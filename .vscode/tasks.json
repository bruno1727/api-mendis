{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build",
        "command": "dotnet",
        "type": "shell",
        "args": [
          "build",
          "${workspaceFolder}/ApiMendis/ApiMendis.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "group": "build",
        "presentation": {
          "reveal": "silent"
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "publish",
        "command": "dotnet",
        "type": "shell",
        "args": [
          "publish",
          "${workspaceFolder}/ApiMendis/ApiMendis.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "group": "build",
        "presentation": {
          "reveal": "silent"
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "watch",
        "command": "dotnet",
        "type": "shell",
        "args": [
          "watch",
          "run",
          "--project",
          "${workspaceFolder}/ApiMendis/ApiMendis.csproj"
        ],
        "group": "build",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": "$msCompile",
        "isBackground": true
      },
      {
        "label": "test",
        "command": "dotnet",
        "type": "shell",
        "args": [
          "test",
          "${workspaceFolder}/ApiMendisTests/ApiMendisTests.csproj"
        ],
        "group": "test",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": "$msCompile"
      },
      {
        "type": "docker-build",
        "label": "docker-build: debug",
        "dependsOn": [
          "build"
        ],
        "dockerBuild": {
          "tag": "apimendis:dev",
          "target": "base",
          "dockerfile": "${workspaceFolder}/ApiMendis/Dockerfile",
          "context": "${workspaceFolder}",
          "pull": true
        },
        "netCore": {
          "appProject": "${workspaceFolder}/ApiMendis/ApiMendis.csproj"
        }
      },
      {
        "type": "docker-run",
        "label": "docker-run: debug",
        "dependsOn": [
          "docker-build: debug"
        ],
        "dockerRun": {},
        "netCore": {
          "appProject": "${workspaceFolder}/ApiMendis/ApiMendis.csproj",
          "enableDebugging": true
        }
      },
      {
        "label": "Start Docker Compose",
        "type": "shell",
        "command": "docker",
        "args": [
          "compose",
          "-f",
          "compose.debug.yaml",
          "up",
          "-d",
          "--build"
        ],
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "close": true
        },
        "problemMatcher": []
      },
      {
        "label": "Stop Docker Compose",
        "type": "shell",
        "command": "docker",
        "args": [
          "compose",
          "-f",
          "compose.debug.yaml",
          "down"
        ],
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "close": true
        },
        "problemMatcher": []
      },
      {
        "label": "Restart Docker Compose",
        "dependsOn": [
          "Stop Docker Compose",
          "Start Docker Compose"
        ],
        "dependsOrder": "sequence",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "close": true
        }
      }
    ]
}
